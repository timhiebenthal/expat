# Copy to .env and fill in. .env is gitignored.

# Required. Token Factory API key: https://tokenfactory.nebius.com/project/api-keys
NEBIUS_API_KEY=

# Optional. Defaults to https://api.tokenfactory.nebius.com/v1
NEBIUS_BASE_URL=

# Optional. Defaults to deepseek-ai/DeepSeek-V4-Flash-0731 ($0.14/$0.28 per 1M tok).
# Set to deepseek-ai/DeepSeek-V4.1-Flash ($0.30/$1.20) to switch.
NEBIUS_MODEL=

# dbt / duckdb
DUCKDB_LOCATION=database/dwh.duckdb
DBT_PROFILES_DIR=./dbt
